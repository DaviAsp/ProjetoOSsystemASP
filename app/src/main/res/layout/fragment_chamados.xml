<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ChamadosFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Marca" />

        <Spinner
            android:id="@+id/spMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Modelo" />

        <Spinner
            android:id="@+id/spModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edNrSerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:ems="10"
            android:hint="Informe nr de serie"
            android:inputType="text"
            android:textAlignment="center"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edDefeito"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_margin="20dp"
            android:ems="10"
            android:gravity="start|top"
            android:hint="Descreva o defeito do dispositivo"
            android:inputType="textMultiLine"
            android:textAlignment="center"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edSolucao"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_margin="20dp"
            android:ems="10"
            android:gravity="start|top"
            android:hint="Descreva a solução aplicada"
            android:inputType="textMultiLine"
            android:textAlignment="center"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGravar"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:text="Finalizar Chamado"
            android:textSize="20sp" />

    </LinearLayout>
</FrameLayout>